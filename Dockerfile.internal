# =============================================================================
# Internal-cluster image: omnivoice-server serving the FINE-TUNED OT_v1 model.
#
# Built FROM SCRATCH on the NVIDIA CUDA base — NOT layered on the deployed
# image — so the model weights are copied exactly once.
#
# ── LAYER ORDER (matches the Harbor `:latest` image; read before editing) ───
# Layer order decides how much a rebuild has to re-push. Two rules:
#
#   1. NEVER `RUN chown -R` over a COPYed tree. It rewrites every file into a
#      NEW layer, duplicating the whole tree. An earlier version of this file
#      ran `RUN chown -R runner:runner /home/runner/models` after the model
#      COPYs, which added a 4.9 GB duplicate of the model + ASR tree.
#      The Harbor image never chowns the models at all — it leaves them
#      root:root mode 644, which uid 10000 can still read. Here we use
#      `COPY --chown=runner:runner`, which sets ownership *while writing* the
#      layer: one layer, correct owner, no duplicate.
#
#   2. Keep the volatile layers at the BOTTOM. Everything expensive (apt, pip,
#      torch, triton, deps, source) goes first so a model/voice change reuses
#      it from cache.
#
# Re-push cost per change:
#   new clone voice (profiles/)         -> ~5 MB
#   new weights (model.safetensors)     -> ~2.3 GB
#   new audio tokenizer                 -> ~770 MB
#   server code edit (omnivoice_server) -> ~400 KB
#   entrypoint edit                     -> ~9 KB
#   new triton source                   -> from the triton layer down (~8 GB)
#
# The model files are COPYed individually rather than as one directory, so a
# change to a small config/tokenizer file does not invalidate the 2.3 GB
# model.safetensors layer.
#
# Reproduces the deployed image's proven runtime layout:
#   * Ubuntu 24.04 + CUDA 12.8 + cuDNN 9 (same base as the deployed image)
#   * Python 3.12, venv at /home/runner/venv
#   * non-root user `runner` (UID/GID 10000)
#   * port 8080, OpenAI /v1 endpoints
#   * omnivoice-triton (kernel fusion + SageAttention + CUDA Graph)
#   * whisper-large-v3-turbo ASR model
#
# Requirements covered:
#   REQ-1  single user-facing container on port 8080
#   REQ-2  GET /health-check returns 200
#   REQ-3  non-root UID 10000, read-only root filesystem
#   REQ-4  all runtime writes go to /tmp (see scripts/internal/entrypoint.sh)
#   REQ-5  single container / single PID 1 process
#   REQ-6  OpenAI /v1 endpoints
#   REQ-7  fine-tuned weights baked in (no host mounts)
#
# Build:
#   podman build -t omnivoice-server:ot-v1-internal -f Dockerfile.internal .
#
# Run:
#   podman run --read-only --user 10000:10000 --tmpfs /tmp:rw,size=8g \
#     -p 8080:8080 --device nvidia.com/gpu=all <image>
# =============================================================================
FROM docker.io/nvidia/cuda:12.8.0-cudnn-runtime-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive

# ── OS + Python 3.12 runtime/build dependencies ─────────────────────────────
# No nvcc needed: omnivoice-triton is a pure-Python wheel (Triton JITs kernels
# at runtime) and sageattention 1.0.6 is pure-Python too.
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 python3-venv python3-dev \
      build-essential libsndfile1 libgomp1 ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# ── REQ-3: non-root user, UID/GID 10000 ─────────────────────────────────────
RUN groupadd -g 10000 runner && \
    useradd -m -s /bin/bash -u 10000 -g 10000 runner && \
    usermod -aG video runner

# ── Writable dirs under /tmp (REQ-4) + app/model dirs ───────────────────────
RUN mkdir -p /home/runner/app /home/runner/models \
             /tmp/runner /tmp/runner/tmp /tmp/runner/profiles && \
    chown -R runner:runner /home/runner /tmp/runner

# ── Environment (matches the deployed image) ────────────────────────────────
ENV CUDA_HOME=/usr/local/cuda
ENV VIRTUAL_ENV=/home/runner/venv
ENV HOME=/tmp/runner
ENV TMPDIR=/tmp/runner/tmp
ENV PATH="${CUDA_HOME}/bin:${VIRTUAL_ENV}/bin:${PATH}"
ENV LD_LIBRARY_PATH="${CUDA_HOME}/lib64:${LD_LIBRARY_PATH}"

# ── Drop to UID 10000 for everything that writes under /home/runner ─────────
# The deployed image does this too, and it is why its venv is runner:runner.
# Running venv/torch/triton/deps as `runner` means the runtime user owns its
# own interpreter and site-packages: no root-owned files under /home/runner,
# writable .pyc caches, and consistency with the cluster-proven image.
USER runner

RUN python3 -m venv --system-site-packages "$VIRTUAL_ENV"

WORKDIR /home/runner/app

# ── PyTorch (cu128). Pinned <2.12: 2.12+ ships cu130 on the PyPI index.
#    cu128 kernels cover sm_80/86 (Ada, incl. RTX 4090 via sm_86 compat),
#    sm_90 (Hopper/H200) and sm_100/sm_120 (Blackwell). ──────────────────────
RUN --mount=type=cache,target=/tmp/runner/.cache/pip \
    pip install "torch>=2.8.0,<2.12" "torchaudio>=2.8.0,<2.12" \
      --index-url https://download.pytorch.org/whl/cu128

# ── omnivoice-triton (vendored local source; provides hybrid+sage mode) ─────
# NOTE: this layer (867 MB — pulls in numba/llvmlite/scipy) is the first
# "expensive" layer. Everything below re-pushes when the triton source changes;
# everything above does not.
# --chown is required: we are already USER runner here, and the build step
# removes this directory afterwards.
COPY --chown=runner:runner vendor/omnivoice-triton /tmp/omnivoice-triton
RUN --mount=type=cache,target=/tmp/runner/.cache/pip \
    pip install /tmp/omnivoice-triton && rm -rf /tmp/omnivoice-triton

# ── Server dependencies ─────────────────────────────────────────────────────
# Install against a stub package first so this slow dependency layer is cached
# across source edits; the real source is installed below with --no-deps.
# Pulls in the `omnivoice` model library (~30 MB).
COPY --chown=runner:runner pyproject.toml README.md ./
RUN --mount=type=cache,target=/tmp/runner/.cache/pip \
    mkdir -p omnivoice_server && touch omnivoice_server/__init__.py && \
    pip install .

# ── Server source (this fork) ───────────────────────────────────────────────
# Sits above the weights so a code edit re-pushes only this ~400 KB layer.
COPY --chown=runner:runner omnivoice_server ./omnivoice_server
RUN --mount=type=cache,target=/tmp/runner/.cache/pip \
    pip install --no-deps .

# ══════════════════════════════════════════════════════════════════════════
# VOLATILE LAYERS BELOW — nothing after this point invalidates the
# dependency layers above.
# ══════════════════════════════════════════════════════════════════════════

# ── REQ-7: bake the FINE-TUNED model weights (copied exactly once) ──────────
# Path/name kept as OmniVoice to match the deployed ConfigMap
# (OMNIVOICE_MODEL_ID=/home/runner/models/OmniVoice).
# model.safetensors sha256 = 4e8b9708fc8525d3113b8f27d71808a00a786773c8a2e12aa6d199cca6f7afdd
#
# `--chown` sets ownership in the SAME layer — there is deliberately no
# `RUN chown -R` afterwards (that is what used to add a 4.9 GB duplicate).
COPY --chown=runner:runner models/OT_v1/model.safetensors      /home/runner/models/OmniVoice/model.safetensors
COPY --chown=runner:runner models/OT_v1/audio_tokenizer       /home/runner/models/OmniVoice/audio_tokenizer
COPY --chown=runner:runner models/OT_v1/tokenizer.json        /home/runner/models/OmniVoice/tokenizer.json
COPY --chown=runner:runner models/OT_v1/tokenizer_config.json /home/runner/models/OmniVoice/tokenizer_config.json
COPY --chown=runner:runner models/OT_v1/config.json           /home/runner/models/OmniVoice/config.json
COPY --chown=runner:runner models/OT_v1/chat_template.jinja   /home/runner/models/OmniVoice/chat_template.jinja
COPY --chown=runner:runner models/OT_v1/README.md             /home/runner/models/OmniVoice/README.md

# ── ASR model (auto-transcribes clone reference audio) ─────────────────────
COPY --chown=runner:runner models/whisper-large-v3-turbo /home/runner/models/whisper-large-v3-turbo

# ── Clone voices (converted from the OT_v1 .pt profiles) ───────────────────
# Seeded into the writable profile dir at startup by the entrypoint.
# Kept as its OWN layer, after the weights, so adding/editing a voice re-pushes
# only ~5 MB instead of the whole model.
#
# WAV ONLY: this directory holds the open format only —
#   profiles/<profile_id>/ref_audio.wav   (mono PCM_16)
#   profiles/<profile_id>/meta.json
# The vLLM-Omni .pt originals (models/OT_v1/speaker_profiles/*.pt) are a
# build-time input that is converted *before* the build by
# scripts/convert_speaker_profiles.py. They are never COPYed here, and
# .dockerignore also excludes **/*.pt as a safety net. Note the model dir is
# COPYed file-by-file for this reason: `COPY models/OT_v1` would drag in the
# .pt speaker profiles.
COPY --chown=runner:runner profiles /home/runner/profiles-baked

# ── Entrypoint: /tmp redirection + profile seeding + NVIDIA chain ──────────
# Last real layer: a tweak here re-pushes only this ~9 kB layer.
# `--chmod` avoids a separate `RUN chmod` layer.
COPY --chown=runner:runner --chmod=755 scripts/internal/entrypoint.sh /usr/local/bin/entrypoint.sh

# ── Runtime configuration (matches the deployed ConfigMap) ──────────────────
ENV OMNIVOICE_HOST=0.0.0.0 \
    OMNIVOICE_PORT=8080 \
    OMNIVOICE_DEVICE=cuda \
    OMNIVOICE_NUM_STEP=32 \
    OMNIVOICE_MAX_CONCURRENT=1 \
    OMNIVOICE_MODEL_ID=/home/runner/models/OmniVoice \
    OMNIVOICE_ASR_MODEL_ID=/home/runner/models/whisper-large-v3-turbo \
    HF_HUB_OFFLINE=1 \
    OMNIVOICE_ENABLE_TRITON=true \
    OMNIVOICE_TRITON_MODE=hybrid \
    OMNIVOICE_TRITON_ENABLE_SAGE=true \
    OMNIVOICE_LOG_LEVEL=info

# ── REQ-1: user-facing port 8080 ────────────────────────────────────────────
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8080/health-check')" || exit 1

# ── REQ-3: run as UID 10000 ─────────────────────────────────────────────────
# (USER runner is already set above, before the venv; restated here so the
#  intent is obvious at the end of the file.)
USER runner

# ── REQ-5: single foreground process (entrypoint exec's it as PID 1) ────────
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["omnivoice-server", \
     "--host", "0.0.0.0", \
     "--port", "8080", \
     "--profile-dir", "/tmp/runner/profiles", \
     "--device", "cuda"]
